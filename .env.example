# Copy to .env (or paste into Dockge's .env editor) and replace every placeholder before starting.
HELFERTOOL_IMAGE=ghcr.io/bearvetic-studios/helfertool:latest
# Use the Docker VM IP (e.g. 192.168.1.100) if cloudflared runs on another host/LXC, or 127.0.0.1 if local.
HELFERTOOL_BIND_ADDRESS=127.0.0.1
HELFERTOOL_PORT=8080
HELFERTOOL_ALLOWED_HOSTS=helfer.bearvetic.ch
HELFERTOOL_BEHIND_PROXY=true
HELFERTOOL_LANGUAGE=de
HELFERTOOL_TIMEZONE=Europe/Zurich
HELFERTOOL_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_50_CHARACTERS_LONG

# Initial Helfertool administrator (created automatically on first start if no superuser exists).
HELFERTOOL_ADMIN_USER=admin
HELFERTOOL_ADMIN_EMAIL=admin@bearvetic.ch
HELFERTOOL_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD

# Optional: only used with compose.bind-storage.yaml and host backup scripts.
HELFERTOOL_STORAGE_PATH=./storage
HELFERTOOL_BACKUP_PATH=./backups

POSTGRES_DB=helfertool
POSTGRES_USER=helfertool
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_DATABASE_PASSWORD

RABBITMQ_VHOST=helfertool
RABBITMQ_USER=helfertool
RABBITMQ_PASSWORD=REPLACE_WITH_A_UNIQUE_RABBITMQ_PASSWORD

# Optional SMTP configuration (leave SMTP_HOST empty to omit mail.send settings).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_STARTTLS=true
# Optional From address and display name, independent of SMTP_USER.
# Empty values preserve Helfertool's defaults.
SMTP_SENDER_ADDRESS=
SMTP_SENDER_NAME=

# Optional delegated Microsoft Graph relay: add compose.smtp-oauth.yaml to the stack.
# SMTP_HOST/PORT/USER/PASSWORD/TLS/STARTTLS above are overridden in relay mode.
# SMTP_SENDER_ADDRESS remains the visible From address (may be a distribution list).
SMTP_RELAY_IMAGE=ghcr.io/bearvetic-studios/helfertool-smtp-graph:latest
OAUTH_TENANT_ID=
OAUTH_CLIENT_ID=
# User's sign-in UPN, NOT the distribution list. Initial browser/MFA login required.
# No client secret or Microsoft 365 password is used.
OAUTH_USERNAME=
